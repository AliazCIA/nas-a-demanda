# Cuentas y carpetas de Samba (imagen ghcr.io/servercontainers/samba). Copia a ~/nas/appdata/samba/samba.env
# Cambia "usuario" por tu usuario (en TODAS las líneas) y pon tu clave. UID = tu `id -u`.
ACCOUNT_usuario=cambia-esto
UID_usuario=1000
GROUPS_usuario=usuario
SAMBA_CONF_LOG_LEVEL=1
SAMBA_VOLUME_CONFIG_archivos=[archivos]; path=/shares/archivos; valid users = usuario; guest ok = no; read only = no; browseable = yes
SAMBA_VOLUME_CONFIG_dispositivos=[dispositivos]; path=/shares/dispositivos; valid users = usuario; guest ok = no; read only = no; browseable = yes

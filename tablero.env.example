# Variables SOLO del Tablero (no recibe el .env del NAS). Copia a tablero.env.
# Direcciones desde las que se abre el Tablero (sin esto, Homepage responde 400):
HOMEPAGE_ALLOWED_HOSTS=192.168.1.50:3000,localhost:3000,127.0.0.1:3000,100.64.0.1:3000
# Opcional: llave de Portainer para el resumen de contenedores (ver docs/tablero.md §Docker)
# HOMEPAGE_VAR_PORTAINER_KEY=

# Publica el RDP de la VM en la red de casa (la VM vive en la NAT de libvirt y no se ve desde la LAN).
# Servicio de SISTEMA (no de usuario: el puerto 3389 < 1024 exige privilegio). Instalar:
#   sudo cp sistema/rdp-vm.service.example /etc/systemd/system/rdp-vm.service
#   (cambia 192.168.122.30 por tu VM_IP) && sudo systemctl enable --now rdp-vm.service
[Unit]
Description=Publica el RDP de la VM en la red de casa
After=network-online.target libvirtd.service
Wants=network-online.target

[Service]
ExecStart=/usr/bin/socat TCP-LISTEN:3389,fork,reuseaddr TCP:192.168.122.30:3389
Restart=always
RestartSec=5
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target

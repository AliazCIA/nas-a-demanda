# Variables del NAS — copia este archivo a .env, llénalo y NUNCA lo subas a git (.gitignore lo excluye).
# Fuente única de verdad de direcciones y secretos: el Panel, los contenedores e instalar.sh leen de aquí.

# --- Tu red (las usa la plantilla del Tablero y el Panel para mostrar direcciones) ---
# título del Tablero
NAS_TITULO=Mi NAS
# IP FIJA de la PC en tu red de casa (resérvala en el módem)
NAS_IP=192.168.1.50
# IP de la PC en Tailscale (tailscale ip -4)
NAS_TAILSCALE_IP=100.64.0.1
# nombre MagicDNS de la PC (para el HTTPS del Panel)
NAS_TAILSCALE_DNS=mi-nas.tu-red.ts.net
# etiqueta del disco externo (solo para los mensajes del Panel)
DISCO_NOMBRE=DATOS

# --- VM de Windows (opcional: deja VM_NOMBRE vacío si no tienes VM) ---
VM_NOMBRE=win11
# IP de la VM en la red NAT de libvirt
VM_IP=192.168.122.30

# --- Panel de encendido (:3001) ---
PANEL_PUERTO=3001
PANEL_USUARIO=admin
PANEL_PASSWORD=cambia-esto

# --- Immich (valores de su documentación oficial; solo cambia la clave) ---
IMMICH_VERSION=v3
DB_USERNAME=postgres
DB_PASSWORD=cambia-esto
DB_DATABASE_NAME=immich
DB_HOSTNAME=immich_postgres
REDIS_HOSTNAME=immich_redis
IMMICH_MACHINE_LEARNING_URL=http://immich_ml:3003

# --- FileBrowser Quantum (:8081) ---
FILEBROWSER_ADMIN_PASSWORD=cambia-esto

# --- Samba (las cuentas viven en appdata/samba/samba.env; aquí solo para claves.sh) ---
SMB_USUARIO=usuario
SMB_PASSWORD=cambia-esto

# --- Syncthing (la GUI pide crearlas la primera vez; anótalas aquí para claves.sh) ---
ST_USUARIO=admin
ST_PASSWORD=cambia-esto
